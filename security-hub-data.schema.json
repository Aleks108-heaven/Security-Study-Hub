{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.invalid/security-hub-data.schema.json",
 "title": "Security Testing and Cybersecurity Study Hub dataset",
 "description": "App-ready study data: tracks, topics, roadmap, modules, glossary, flashcards, practice questions, security test cases, tools, labs, resources and reference tables. Original study material; not official exam content.",
 "type": "object",
 "$defs": {
  "topicId": {
   "enum": [
    "foundations",
    "istqb",
    "process",
    "sdlc",
    "web",
    "api",
    "mechanisms",
    "infra",
    "ai",
    "human",
    "pentest",
    "blue",
    "grc",
    "tools"
   ]
  },
  "kLevel": {
   "enum": [
    "K1",
    "K2",
    "K3",
    "K4"
   ]
  },
  "verify": {
   "type": "boolean",
   "description": "true = rests on a fact the hub did not re-check against a primary source on the as-of date"
  }
 },
 "properties": {
  "meta": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1
    },
    "datasetVersion": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "asOf": {
     "type": "string",
     "format": "date"
    },
    "hubUrl": {
     "type": "string",
     "format": "uri"
    },
    "language": {
     "type": "string",
     "minLength": 1
    },
    "notice": {
     "type": "string",
     "minLength": 1
    },
    "conventions": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "counts": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "required": [
    "title",
    "datasetVersion",
    "asOf",
    "hubUrl",
    "language",
    "notice",
    "conventions",
    "counts"
   ],
   "additionalProperties": false
  },
  "tracks": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "description": {
      "type": "string",
      "minLength": 1
     },
     "topics": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/topicId"
      },
      "minItems": 1,
      "uniqueItems": true
     }
    },
    "required": [
     "id",
     "name",
     "description",
     "topics"
    ],
    "additionalProperties": false
   },
   "minItems": 4
  },
  "topics": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "$ref": "#/$defs/topicId"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "sections": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 1,
       "maximum": 24
      },
      "minItems": 1
     },
     "scope": {
      "type": "string",
      "minLength": 1
     },
     "module": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "id",
     "name",
     "sections",
     "scope",
     "module"
    ],
    "additionalProperties": false
   },
   "minItems": 14
  },
  "roadmap": {
   "type": "object",
   "properties": {
    "totalHours": {
     "type": "integer",
     "minimum": 0
    },
    "totalHoursNote": {
     "type": "string",
     "minLength": 1
    },
    "stages": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "integer",
        "minimum": 0
       },
       "name": {
        "type": "string",
        "minLength": 1
       },
       "hours": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "focus": {
        "type": "string",
        "minLength": 1
       },
       "gate": {
        "type": "string",
        "minLength": 1
       },
       "topics": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/topicId"
        },
        "minItems": 1
       }
      },
      "required": [
       "id",
       "name",
       "hours",
       "focus",
       "gate",
       "topics"
      ],
      "additionalProperties": false
     },
     "minItems": 1
    },
    "specialisations": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "name": {
        "type": "string",
        "minLength": 1
       },
       "topics": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/topicId"
        },
        "minItems": 1
       },
       "portfolioProject": {
        "type": "string",
        "minLength": 1
       }
      },
      "required": [
       "id",
       "name",
       "topics",
       "portfolioProject"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "totalHours",
    "totalHoursNote",
    "stages",
    "specialisations"
   ],
   "additionalProperties": false
  },
  "certifications": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "stage": {
      "type": "string",
      "minLength": 1
     },
     "fits": {
      "type": "string",
      "minLength": 1
     },
     "notes": {
      "type": "string",
      "minLength": 1
     },
     "verify": {
      "$ref": "#/$defs/verify"
     }
    },
    "required": [
     "id",
     "name",
     "stage",
     "fits",
     "notes",
     "verify"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "modules": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "topic": {
      "$ref": "#/$defs/topicId"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "section": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
     },
     "summary": {
      "type": "string",
      "minLength": 1
     },
     "estimatedMinutes": {
      "type": "integer",
      "minimum": 5
     },
     "objectives": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "k": {
         "enum": [
          "K1",
          "K2",
          "K3",
          "K4"
         ]
        },
        "text": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "k",
        "text"
       ],
       "additionalProperties": false
      },
      "minItems": 1
     },
     "keyPoints": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     },
     "practice": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "required": [
     "id",
     "topic",
     "title",
     "section",
     "summary",
     "estimatedMinutes",
     "objectives",
     "keyPoints",
     "practice"
    ],
    "additionalProperties": false
   },
   "minItems": 14
  },
  "glossary": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^g-[a-z0-9-]+$"
     },
     "term": {
      "type": "string",
      "minLength": 1
     },
     "definition": {
      "type": "string",
      "minLength": 20
     },
     "topic": {
      "$ref": "#/$defs/topicId"
     },
     "verify": {
      "$ref": "#/$defs/verify"
     }
    },
    "required": [
     "id",
     "term",
     "definition",
     "topic",
     "verify"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "flashcards": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^fc-[a-z]+-\\d{2}$"
     },
     "topic": {
      "$ref": "#/$defs/topicId"
     },
     "q": {
      "type": "string",
      "minLength": 1
     },
     "a": {
      "type": "string",
      "minLength": 1
     },
     "difficulty": {
      "enum": [
       1,
       2,
       3
      ]
     },
     "core": {
      "type": "boolean"
     },
     "verify": {
      "$ref": "#/$defs/verify"
     }
    },
    "required": [
     "id",
     "topic",
     "q",
     "a",
     "difficulty",
     "core",
     "verify"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "questions": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^q-[a-z]+-\\d{2}$"
     },
     "topic": {
      "$ref": "#/$defs/topicId"
     },
     "k": {
      "enum": [
       "K1",
       "K2",
       "K3",
       "K4"
      ]
     },
     "type": {
      "const": "single"
     },
     "stem": {
      "type": "string",
      "minLength": 1
     },
     "options": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 4
     },
     "answer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
     },
     "explanation": {
      "type": "string",
      "minLength": 30
     },
     "core": {
      "type": "boolean"
     },
     "verify": {
      "$ref": "#/$defs/verify"
     }
    },
    "required": [
     "id",
     "topic",
     "k",
     "type",
     "stem",
     "options",
     "answer",
     "explanation",
     "core",
     "verify"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "testcases": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Z]+-\\d{2}$"
     },
     "group": {
      "type": "string",
      "minLength": 1
     },
     "feature": {
      "type": "string",
      "minLength": 1
     },
     "type": {
      "enum": [
       "positive",
       "negative",
       "boundary",
       "exploratory"
      ]
     },
     "test": {
      "type": "string",
      "minLength": 1
     },
     "expected": {
      "type": "string",
      "minLength": 1
     },
     "refs": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     }
    },
    "required": [
     "id",
     "group",
     "feature",
     "type",
     "test",
     "expected",
     "refs"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "tools": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "purpose": {
      "type": "string",
      "minLength": 1
     },
     "tools": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     },
     "cost": {
      "type": "string",
      "minLength": 1
     },
     "use": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "id",
     "purpose",
     "tools",
     "cost",
     "use"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "labs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "url": {
      "type": [
       "string",
       "null"
      ],
      "format": "uri"
     },
     "focus": {
      "type": "string",
      "minLength": 1
     },
     "cost": {
      "type": "string",
      "minLength": 1
     },
     "level": {
      "type": "string",
      "minLength": 1
     },
     "sections": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 1,
       "maximum": 24
      }
     },
     "checked": {
      "type": "boolean"
     }
    },
    "required": [
     "id",
     "name",
     "url",
     "focus",
     "cost",
     "level",
     "sections",
     "checked"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "resources": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
     },
     "kind": {
      "type": "string",
      "minLength": 1
     },
     "note": {
      "type": "string"
     },
     "verified": {
      "type": "boolean"
     }
    },
    "required": [
     "id",
     "name",
     "url",
     "kind",
     "note",
     "verified"
    ],
    "additionalProperties": false
   },
   "minItems": 1
  },
  "reference": {
   "type": "object",
   "description": "Each key is a table extracted from the hub: columns (key and label) plus rows keyed by column key; a row may carry the first link as url.",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "columns": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "key": {
         "type": "string",
         "minLength": 1
        },
        "label": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "key",
        "label"
       ],
       "additionalProperties": false
      },
      "minItems": 1
     },
     "rows": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       }
      },
      "minItems": 1
     }
    },
    "required": [
     "columns",
     "rows"
    ],
    "additionalProperties": false
   }
  },
  "exams": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "questions": {
      "type": "integer",
      "minimum": 1
     },
     "points": {
      "type": "integer",
      "minimum": 1
     },
     "passPoints": {
      "type": "integer",
      "minimum": 1
     },
     "minutes": {
      "type": "integer",
      "minimum": 1
     },
     "note": {
      "type": "string",
      "minLength": 1
     },
     "id": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "name",
     "questions",
     "points",
     "passPoints",
     "minutes",
     "note",
     "id"
    ],
    "additionalProperties": false
   }
  },
  "app": {
   "type": "object",
   "properties": {
    "leitner": {
     "type": "object",
     "properties": {
      "boxes": {
       "type": "integer",
       "minimum": 2
      },
      "intervalsDays": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 0
       },
       "minItems": 2
      },
      "note": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "boxes",
      "intervalsDays",
      "note"
     ],
     "additionalProperties": false
    },
    "quiz": {
     "type": "object",
     "properties": {
      "defaultLength": {
       "type": "integer",
       "minimum": 1
      },
      "examLengthFromProfile": {
       "type": "boolean"
      },
      "passPercent": {
       "type": "integer",
       "minimum": 1,
       "maximum": 100
      }
     },
     "required": [
      "defaultLength",
      "examLengthFromProfile",
      "passPercent"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "leitner",
    "quiz"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "meta",
  "tracks",
  "topics",
  "roadmap",
  "certifications",
  "modules",
  "glossary",
  "flashcards",
  "questions",
  "testcases",
  "tools",
  "labs",
  "resources",
  "reference",
  "exams",
  "app"
 ],
 "additionalProperties": false
}